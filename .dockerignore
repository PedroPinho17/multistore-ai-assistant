# O Dockerfile copia pyproject.toml, uv.lock, README.md, src/, db/, web/, data/, docker/
# e frontend/ (build multi-stage Node → dist em /app).
# Tudo o resto fica fora do contexto de build: mais rápido (models/ tem ~3 GB) e nunca
# envia segredos (.env, backups da BD) ao daemon do Docker.

# Segredos e dados privados
.env
.env.*
!.env.example
backup/
*.dump
*.pem
*.key
Contas-teste.txt
COMO_CORRER*.txt

# Grandes ou gerados (models/, eval/ e data/avatars/ são montados como volumes pelo docker-compose)
models/
eval/
data/avatars/
*.zip
*.joblib
*.safetensors
.venv/
**/__pycache__/
*.py[oc]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Frontend: o stage Node faz npm ci; não enviar node_modules/dist locais
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/**/.vite/


# Não são precisos na imagem
.git/
.github/
.vscode/
.idea/
tests/
notebooks/
docs/

