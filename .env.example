# Copy to .env and fill in the values:   cp .env.example .env
# Generate random secrets with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Database ---------------------------------------------------------------
# Superuser password; Docker uses it when it first creates the database.
POSTGRES_PASSWORD=change-me
# Owner connection (same password as POSTGRES_PASSWORD).
DATABASE_URL=postgresql://multistore:change-me@localhost:5433/multistore
# Read-only role used to run the SQL written by the LLM (pick another password;
# data.set_passwords applies it to the role).
READONLY_DATABASE_URL=postgresql://assistente:change-me-too@localhost:5433/multistore

# --- LLM (any OpenAI-compatible endpoint) ------------------------------------
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional: key from a second account, used automatically when the main key
# runs out of quota (HTTP 429, e.g. Groq's free tier daily token limit)
GROQ_API_KEY_FALLBACK=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# --- API -----------------------------------------------------------------------
# At least 32 random characters, or the API refuses to start.
JWT_SECRET=
# 1 turns on Swagger at /docs
ENABLE_DOCS=0
# Host port of the Docker app
APP_PORT=8001

# --- Password reset by email (optional) -----------------------------------------
# Public address of the app, used in the reset link sent by email
APP_URL=http://localhost:8001
# Without SMTP_HOST no email is sent (the forgot-password page still answers the same,
# so it never reveals which emails exist). Gmail: smtp.gmail.com + an app password.
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none (local test servers only)
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# Sender shown in the email; defaults to SMTP_USER
SMTP_FROM=Multistore AI <no-reply@example.com>

# --- Optional ------------------------------------------------------------------
# xlmr (default, if models/intent-xlmr exists) or minilm
# INTENT_MODEL=xlmr
# HF_HUB_OFFLINE=1
# Private admin account created by Docker on start (password with 12+ characters)
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# ADMIN_EMAIL=           (lets the admin reset the password by email)
# DB_POOL_MAX=10
# Folder for profile photos (default: data/avatars; Docker mounts it as a volume)
# AVATAR_DIR=
